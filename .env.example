# Copy to .env (gitignored). The bot reads it from the repo root; set variables win.
PHONELLM_API_KEY=    # PhoneLLM (hosted): both characters
PHONELLM_BASE_URL=   # its OpenAI-compatible endpoint, ending in /v1
LLM_MODEL=           # the PhoneLLM model id to ask for
JEV_API_KEY=         # Jev (TypeSafe): who you're talking to
CARTESIA_API_KEY=    # both voices, one TTS
DEEPGRAM_API_KEY=    # speech to text

# Optional
# LLM_REPETITION_PENALTY=1.1   # 1.0 turns it off (PhoneLLM stays at temperature 0 regardless)
# JEV_MODEL=jev-1.13.0
# BOT_LOG_LEVEL=INFO
